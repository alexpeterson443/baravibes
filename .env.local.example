# Copy this file to .env.local and fill in your values

# ── Turso Database (get these from turso.tech) ────────────────────────────────
# Sign up free at https://turso.tech → create a database → get these values
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string (32+ characters)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars!!

# ── Admin Account ─────────────────────────────────────────────────────────────
# Whoever registers with this email gets admin (Addy's) role
ADMIN_EMAIL=addy@example.com
